<UserControl x:Class="CodexLedWidget.Wpf.QuotaOrbView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="118"
             Height="118"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="Auto">
    <Grid Width="118" Height="118">
        <Ellipse Width="112"
                 Height="112"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.33,0.22"
                                     GradientOrigin="0.22,0.12"
                                     RadiusX="0.9"
                                     RadiusY="0.9">
                    <GradientStop Color="#FAFFFFFF" Offset="0" />
                    <GradientStop Color="#D8F2FAFF" Offset="0.45" />
                    <GradientStop Color="#A8DDEBFF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse x:Name="OuterRim"
                 Width="112"
                 Height="112"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Fill="Transparent"
                 Stroke="#3A18CB8B"
                 StrokeThickness="1.8" />

        <Ellipse Width="80"
                 Height="80"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Fill="Transparent"
                 Stroke="#1E37474A"
                 StrokeThickness="17" />

        <Path x:Name="ProgressArc"
              StrokeThickness="17"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round" />

        <Path x:Name="ProgressGloss"
              StrokeThickness="5"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              Opacity="0.45">
            <Path.Stroke>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                    <GradientStop Color="#D0FFFFFF" Offset="0" />
                    <GradientStop Color="#20FFFFFF" Offset="0.7" />
                </LinearGradientBrush>
            </Path.Stroke>
        </Path>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="MeterLabel"
                       Text="1w"
                       FontSize="10"
                       LineHeight="14"
                       LineStackingStrategy="BlockLineHeight"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       Foreground="{StaticResource WidgetMutedBrush}" />
            <TextBlock x:Name="MeterPercent"
                       Text="--"
                       FontSize="22"
                       LineHeight="28"
                       LineStackingStrategy="BlockLineHeight"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Foreground="{StaticResource WidgetTextBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
